# Copy to `.env.local` for local testing (never commit real values — *.local is ignored).
# In production these are set in Netlify → Site configuration → Environment variables.
# Supabase → Project Settings → API: "Project URL" and the "anon public" key.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key
